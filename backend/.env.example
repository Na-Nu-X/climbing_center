# Copy to `.env` and adjust. All keys are optional for local development.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for SQLite. Production example:
# DATABASE_URL=postgres://climbing:secret@localhost:5432/climbing_center
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=
API_ANON_THROTTLE=120/minute
API_FORMS_THROTTLE=20/hour
